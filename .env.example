# Database setup
# This project uses PostgreSQL for production readiness
DATABASE_URL="postgresql://user:password@localhost:5432/pinaffiliate?schema=public"

# Next Auth setup
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# AI Configuration
# This key is required for generation
GEMINI_API_KEY=""

# Affiliate Tag Fallbacks (if user settings are not configured)
AMAZON_AFFILIATE_TAG="YOURTAG-20"
AFFILIATE_TAG="YOURTAG"
